# ==============================================================================
# For Your Consideration — Environment Configuration
# ==============================================================================

# Server Domain & DID Identity
HOSTNAME=fyc.mike10010100.com
SERVICE_DID=did:web:fyc.mike10010100.com
FEED_RKEY=for-your-consideration

# Administrator Handle or DID (controls feed publishing lock)
ADMIN_HANDLE=mike10010100.com

# Session secret for HMAC-signed OAuth sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
# Route public hostname fyc.mike10010100.com to: http://feed-engine:3000
TUNNEL_TOKEN=

# Host Port Mapping (avoids conflict with other services on host port 3000)
PORT_BIND=3030

# Ingestion & History Settings
REPLAY_HOURS=168
RETENTION_DAYS=30
SNAPSHOT_PATH=/data/snapshot.bin
SNAPSHOT_INTERVAL_SECS=300
RUST_LOG=info,for_your_consideration=info

# Resource limits
MEM_LIMIT=8192M
